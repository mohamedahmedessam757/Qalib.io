# Environment
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.your-ref.supabase.co:5432/postgres

# OpenRouter AI (server-only — never expose to the browser)
OPENROUTER_API_KEY=
# Free tier is rate-limited (~50 req/day). For production use a paid model, e.g.:
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
